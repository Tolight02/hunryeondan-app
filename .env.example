# 이 계정으로 서버가 대신 로그인해서, 모든 방문자에게 식단을 보여줍니다.
# (사용하는 사람들은 로그인할 필요 없음 - 관리자 한 명 것만 있으면 됨)
WELSTORY_USERNAME=관리자_아이디
WELSTORY_PASSWORD=관리자_비밀번호

# 식당은 이제 신분(훈련병/조교/특기학교/후보생)별로 server.js의 CATEGORY_CONFIG에서
# 자동으로 찾아서 씁니다 - 이 변수는 더 이상 안 씁니다.

# 방문자 통계(/api/admin/stats?key=...) 조회할 때 쓰는 비밀키. 아무 긴 문자열이나 직접 정해서 넣으세요.
ADMIN_KEY=아무거나_긴_비밀문자열로_직접_정하기

PORT=3000
